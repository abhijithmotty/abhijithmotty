    document.getElementById("win").style.transform = "";
    document.getElementById("win").style.opacity = "";
  }, 800);
}

/* ============================================================
   MATRIX EASTER EGG
   ============================================================ */
const mWrap = document.getElementById("matrix");
const mCanvas = document.getElementById("mcanvas");
const mHint = document.getElementById("mhint");
let mCtx, mAnim, mCols;

function startMatrix() {
  mWrap.style.display = "block";
  mHint.style.display = "block";
  mCanvas.width = window.innerWidth;
  mCanvas.height = window.innerHeight;
  mCtx = mCanvas.getContext("2d");
  const fs = 16;
  mCols = Math.floor(mCanvas.width / fs);
  const drops = new Array(mCols).fill(1);
  const chars = "アイウエオカキクケコサシスセソABCDEF0123456789$#@!<>[]{}".split("");
  function draw() {
    mCtx.fillStyle = "rgba(0,0,0,0.06)";
    mCtx.fillRect(0,0,mCanvas.width,mCanvas.height);
    mCtx.fillStyle = "#0f0";
    mCtx.font = fs + "px 'JetBrains Mono', monospace";
    for (let i = 0; i < drops.length; i++) {
      const c = chars[Math.floor(Math.random()*chars.length)];
      mCtx.fillText(c, i*fs, drops[i]*fs);
      if (drops[i]*fs > mCanvas.height && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    }
    mAnim = requestAnimationFrame(draw);
  }
  draw();
}
function stopMatrix() {
  cancelAnimationFrame(mAnim);
  mWrap.style.display = "none";
  mHint.style.display = "none";
}
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") stopMatrix();
});
window.addEventListener("click", focusInput);
</script>
