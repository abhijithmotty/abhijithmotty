<style>
  :root {
    --bg: #1e1e2e;
    --bg-dark: #181825;
    --fg: #cdd6f4;
    --muted: #6c7086;
    --red: #f38ba8;
    --green: #a6e3a1;
    --yellow: #f9e2af;
    --blue: #89b4fa;
    --mauve: #cba6f7;
    --sapphire: #74c7ec;
    --pink: #f5c2e7;
    --white: #ffffff;
    --accent: var(--red);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    height: 100%;
    background:
      radial-gradient(ellipse at top, #313244 0%, #11111b 100%);
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    color: var(--fg);
    overflow: hidden;
  }
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  /* ---------- Terminal window ---------- */
  .window {
    width: min(1200px, 100%);
    height: min(760px, 95vh);
    background: var(--bg);
    border-radius: 12px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .titlebar {
    height: 34px;
    background: #11111b;
    display: flex;
    align-items: center;
    padding: 0 14px;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .dots { display: flex; gap: 8px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; cursor: pointer; }
  .dot.red   { background: #ff5f57; }
  .dot.amber { background: #febc2e; }
  .dot.green { background: #28c840; }
  .title {
    position: absolute; left: 0; right: 0;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    pointer-events: none;
  }

  /* ---------- Split layout ---------- */
  .split {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 0;
  }
  .pane {
    padding: 20px 22px;
    overflow-y: auto;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .pane.left { border-right: 1px solid rgba(255,255,255,0.04); }
  .pane::-webkit-scrollbar { width: 6px; }
  .pane::-webkit-scrollbar-thumb { background: #313244; border-radius: 3px; }

  /* ---------- ASCII art ---------- */
  .cmd-line { color: var(--fg); margin-bottom: 8px; }
  .prompt-user { color: var(--red); font-weight: 600; }
  .prompt-path { color: var(--blue); }
  .ascii {
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px;
    line-height: 6.5px;
    letter-spacing: 0;
    white-space: pre;
    color: var(--fg);
    margin: 6px 0 14px;
    text-shadow: 0 0 1px currentColor;
    transition: color 0.4s;
  }
  .ascii.glitch { animation: glitch 0.25s steps(2) 1; }
  @keyframes glitch {
    0%   { transform: translate(0,0);  filter: hue-rotate(0deg); }
    25%  { transform: translate(-2px,1px); filter: hue-rotate(90deg); }
    50%  { transform: translate(2px,-1px); filter: hue-rotate(180deg); }
    75%  { transform: translate(-1px,2px); filter: hue-rotate(270deg); }
    100% { transform: translate(0,0); filter: hue-rotate(0deg); }
  }
  .quote {
    color: var(--muted);
    font-style: italic;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed rgba(255,255,255,0.08);
    font-size: 12.5px;
  }

  /* ---------- Right terminal ---------- */
  .term-line { white-space: pre-wrap; word-break: break-word; }
  .term-out  { color: var(--fg); margin-bottom: 2px; }
  .k { color: var(--red); font-weight: 600; }
  .v { color: var(--fg); }
  .sep { color: var(--muted); }
  .hr { color: var(--muted); margin: 4px 0 10px; }
  .swatches { display: flex; gap: 6px; margin: 14px 0; }
  .sw { width: 18px; height: 18px; border-radius: 3px; border: 1px solid rgba(255,255,255,0.15); }
  .link { color: var(--sapphire); text-decoration: none; border-bottom: 1px dashed transparent; }
  .link:hover { border-bottom-color: var(--sapphire); }

  /* ---------- Input line ---------- */
  .input-row {
    display: flex; align-items: center; gap: 6px;
    margin-top: 6px;
  }
  .input-row input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--red);
  }
  .cursor {
    display: inline-block;
    width: 8px; height: 15px;
    background: var(--fg);
    animation: blink 1s steps(2) infinite;
    vertical-align: middle;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- Matrix rain ---------- */
  #matrix {
    position: fixed; inset: 0;
    background: #000;
    z-index: 999;
    display: none;
  }
  #matrix canvas { width: 100%; height: 100%; display: block; }
  .matrix-hint {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    color: #0f0; font-family: 'JetBrains Mono', monospace; z-index: 1000;
    text-shadow: 0 0 8px #0f0;
  }

  @media (max-width: 800px) {
    .split { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .pane.left { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .ascii { font-size: 4.5px; line-height: 4.5px; }
  }
</style>
