/* Frame variations for animation (blinking eyes / breathing) */
function makeFrame(state) {
  let frame = asciiBase.map(l => l);
  // eye blink on lines 13-16 (index roughly)
  if (state === "blink") {
    frame[13] = "*@@%. -%@@#:      ==            ==       .:*@@%-  .%@@      ";
    frame[14] = "%@@+ :%@@*.      ===           ===        .:+@@%: .*@@%     ";
  }
  if (state === "glance") {
    frame[13] = "*@@%. -%@@#:       ##            ##      .:*@@%-  .%@@      ";
    frame[14] = "%@@+ :%@@*.       ###           ###       .:+@@%: .*@@%     ";
  }
  return frame.join("\n");
}

