const frameCycle = ["normal","normal","normal","normal","normal","glance","normal","normal","blink","normal","normal","normal","normal","glance","normal","normal","normal","normal","blink"];
function tick() {
  const s = frameCycle[frameIdx % frameCycle.length];
  asciiEl.textContent = makeFrame(s);
  frameIdx++;
}
