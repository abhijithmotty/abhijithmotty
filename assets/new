/* -------- Input handling -------- */

const inputRow = document.createElement("div");
inputRow.className = "input-row";
inputRow.innerHTML = promptHTML() + `<input id="cmdInput" autocomplete="off" autofocus spellcheck="false"/>`;
term.appendChild(inputRow);

const input = document.getElementById("cmdInput");

function focusInput() { input.focus(); }

function clearTerm() {
  [...term.querySelectorAll(".term-line")].forEach(n => n.remove());
}

function runCommand(raw) {
  const trimmed = raw.trim();
  if (!trimmed) { printCommand(""); return; }
  printCommand(trimmed);
  history.push(trimmed);
  histPos = history.length;

  const [cmd, ...args] = trimmed.split(/\s+/);
  const key = cmd.toLowerCase();

  if (commands[key]) {
    const out = commandsargs;
    if (out !== null && out !== undefined) print(out);
  } else {
    print(`<span class="k">${esc(cmd)}</span>: command not found. type '<span class="k">help</span>'`);
  }
}

input.addEventListener("keydown", (e) => {
  if (e.key === "Enter") {
    const v = input.value;
    input.value = "";
    runCommand(v);
  } else if (e.key === "ArrowUp") {
    if (histPos > 0) { histPos--; input.value = history[histPos]; }
    e.preventDefault();
  } else if (e.key === "ArrowDown") {
    if (histPos < history.length - 1) { histPos++; input.value = history[histPos]; }
    else { histPos = history.length; input.value = ""; }
    e.preventDefault();
  } else if (e.key === "Tab") {
    e.preventDefault();
    const cur = input.value.trim();
    const opts = Object.keys(commands).filter(c => c.startsWith(cur));
    if (opts.length === 1) input.value = opts[0] + " ";
    else if (opts.length > 1) print(opts.join("   "));
  } else if (e.ctrlKey && e.key.toLowerCase() === "l") {
    e.preventDefault(); clearTerm();
  }
});

